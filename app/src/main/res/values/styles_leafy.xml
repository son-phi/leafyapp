<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Leafy.Shape.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Leafy.Shape.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Leafy.Button.Filled" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/leafy_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Leafy.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/leafy_primary</item>
        <item name="strokeColor">@color/leafy_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Leafy.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/leafy_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Leafy.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_leafy_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Leafy.Banner.Warning" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_leafy_banner_warning</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="Leafy.Banner.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Leafy.Banner.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/leafy_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Leafy.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/leafy_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Leafy.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_leafy_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/leafy_primary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Leafy.Pill.Neutral">
        <item name="android:background">@drawable/bg_leafy_pill_neutral</item>
        <item name="android:textColor">@color/leafy_text_secondary</item>
    </style>
</resources>
