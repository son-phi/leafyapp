<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- PHẦN 1: DANH SÁCH CÂY (Hiện khi có dữ liệu) -->
    <!-- Mặc định ẩn (gone) để chờ kiểm tra dữ liệu -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_my_plants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PHẦN 2: EMPTY STATE (Hiện khi KHÔNG có cây) -->
    <!-- Căn giữa màn hình -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ảnh minh họa (Dùng tạm icon lịch, bạn đổi ảnh sau) -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/seedling_solid_full"
            app:tint="@color/green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Garden is Empty"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage your plant family, view care tips, and track plant growth here."
            android:textAlignment="center"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Nút Add First Plant -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_first_plant"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:text="Add First Plant"
            android:textAllCaps="false"

            android:textColor="#000000"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cornerRadius="24dp"

            app:rippleColor="#334CAF50" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>