<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScheduleDraft"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_leafy_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDraftIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_leafy_pill"
            android:gravity="center"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDraftTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/leafy_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDraftNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/leafy_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@android:color/white"
            app:trackTint="@color/leafy_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDraftFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDraftInterval"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:hint="@string/add_plant_schedule_interval"
            app:boxStrokeColor="@color/leafy_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDraftInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDraftStart"
            style="@style/Leafy.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDraftTime"
            style="@style/Leafy.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
