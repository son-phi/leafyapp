<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingStart="8dp"> <!-- Thụt lề trái 8dp -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Icon Task -->
        <ImageView
            android:id="@+id/img_task_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_light_blue"
            android:padding="8dp"
            android:src="@drawable/ic_water_drop"
            app:tint="#2196F3" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Tên Task -->
            <TextView
                android:id="@+id/tv_task_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watering"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Thông tin hoàn thành -->
            <LinearLayout
                android:id="@+id/layout_completed_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#4CAF50"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Today Completed"
                        android:textColor="#4CAF50"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_next_due_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Next task: 2 Dec"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/cb_task_done"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:buttonTint="#E0E0E0"
            android:background="@null"
            android:scaleX="1.2"
            android:scaleY="1.2"/>

        <!-- Icon Tick tròn xám -->
        <ImageView
            android:id="@+id/img_done_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="#BDBDBD"
            android:visibility="gone"/>

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="56dp"
        android:background="#F0F0F0"/>

</LinearLayout>