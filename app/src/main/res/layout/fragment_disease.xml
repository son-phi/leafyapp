<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Healthy VIEW -->
    <LinearLayout
        android:id="@+id/layoutHealthy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieHealthy"
            android:layout_width="400dp"
            android:layout_height="400dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/healthy" />

        <TextView
            android:id="@+id/tvHealthy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Healthy\nAnd\nThriving!"
            android:textSize="80sp"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:fontFamily="@font/healthy"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"/>

    </LinearLayout>

    <!-- Disease VIEW -->
    <ScrollView
        android:id="@+id/scrollDisease"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TIÊU ĐỀ -->
            <TextView
                android:id="@+id/tvDiseaseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disease_info_title_short"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingBottom="24dp" />

            <!-- Nơi chứa từng block -->
            <LinearLayout
                android:id="@+id/containerDiseases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:paddingTop="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkSick"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="80dp"
                android:text="@string/choose_affected_plants_vi"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:padding="14dp"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp"
                app:cornerRadius="25dp" />
        </LinearLayout>

    </ScrollView>
    <ImageButton
        android:id="@+id/btnCloseDisease"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:elevation="15dp"
        app:tint="#000000"
        android:layout_gravity="top|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
