<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_leafy_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPick"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/leafy_primary_container"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Leafy.Shape.Medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPickName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/leafy_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPickSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/leafy_text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPickCareLevel"
        style="@style/Leafy.Pill.Neutral" />
</LinearLayout>
