<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leafy_background"
    android:orientation="vertical">

    <!-- Tiêu đề + chọn vườn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/garden_title"
                android:textColor="@color/leafy_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGardenSettings"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/garden_manage"
                android:textColor="@color/leafy_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconSize="16dp"
                app:iconTint="@color/leafy_text_secondary" />
        </LinearLayout>

        <!-- Cá nhân / Gia đình -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGardenMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:checkedButton="@id/btnModePersonal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModePersonal"
                style="@style/Leafy.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/garden_mode_personal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeFamily"
                style="@style/Leafy.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/garden_mode_family" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Chưa có vườn gia đình -->
        <LinearLayout
            android:id="@+id/layoutNoGarden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_leafy_icon_tile"
                android:gravity="center"
                android:text="🏡"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/garden_family_empty_title"
                android:textColor="@color/leafy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/garden_family_empty_body"
                android:textColor="@color/leafy_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateGarden"
                style="@style/Leafy.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/garden_family_create" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinGarden"
                style="@style/Leafy.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/garden_family_join" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/leafy_background"
        app:tabGravity="fill"
        app:tabMaxWidth="0dp"
        app:tabIndicatorColor="@color/leafy_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/leafy_primary_container"
        app:tabSelectedTextColor="@color/leafy_primary"
        app:tabTextAppearance="@style/Leafy.TabText"
        app:tabTextColor="@color/leafy_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/leafy_outline" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
