<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="Back"
        android:src="@drawable/ic_back"
        app:tint="#1B1B1B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIdentifyAgain"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="Nhận diện lại"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#2E7D32"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/btnIdentifyAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_warning_triangle"
                app:tint="#2E7D32"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Không thể nhận diện cây"
                android:textStyle="bold"
                android:textSize="26sp"
                android:textColor="#1B1B1B"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hãy thử chụp lại theo gợi ý bên dưới để nhận diện chính xác hơn."
                android:textSize="15sp"
                android:textColor="#6B6B6B"
                android:gravity="center"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#E6E6E6"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mẹo nhận diện"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#1B1B1B"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chụp đủ sáng, lấy nét rõ, chỉ để 1 đối tượng trong khung hình."
                android:textSize="15sp"
                android:textColor="#6B6B6B"
                android:gravity="center"/>

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgGoodExample"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/plant_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CircleImage"
                    app:strokeColor="#EDEDED"
                    app:strokeWidth="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|top"
                    android:layout_marginEnd="6dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#2E7D32">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/blockTooClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgBad1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/plant_bad_1"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CircleImage"
                            app:strokeColor="#EDEDED"
                            app:strokeWidth="4dp"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="end|top"
                            android:layout_marginEnd="2dp"
                            android:layout_marginTop="2dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#C62828">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_close_x"
                                app:tint="#FFFFFF"/>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBad1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Quá gần"
                        android:textSize="14sp"
                        android:textColor="#1B1B1B"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockTooFar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgBad2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/plant_bad_2"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CircleImage"
                            app:strokeColor="#EDEDED"
                            app:strokeWidth="4dp"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="end|top"
                            android:layout_marginEnd="2dp"
                            android:layout_marginTop="2dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#C62828">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_close_x"
                                app:tint="#FFFFFF"/>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBad2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Quá xa"
                        android:textSize="14sp"
                        android:textColor="#1B1B1B"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockMulti"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgBad3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/plant_bad_3"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CircleImage"
                            app:strokeColor="#EDEDED"
                            app:strokeWidth="4dp"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="end|top"
                            android:layout_marginEnd="2dp"
                            android:layout_marginTop="2dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#C62828">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_close_x"
                                app:tint="#FFFFFF"/>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBad3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Nhiều cây"
                        android:textSize="14sp"
                        android:textColor="#1B1B1B"/>
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
