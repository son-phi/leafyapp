<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leafy_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_close"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leafy_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/add_plant_title"
            android:textColor="@color/leafy_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Ảnh cây -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPlantPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/leafy_surface_variant"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Leafy.Shape.Large" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRemovePhoto"
                        style="@style/Leafy.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/leafy_surface"
                        android:text="@string/add_plant_photo_remove" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickPhoto"
                        style="@style/Leafy.Button.Filled"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="@string/add_plant_photo_add" />
                </LinearLayout>
            </FrameLayout>

            <!-- Loài cây -->
            <TextView
                style="@style/Leafy.SectionTitle"
                android:text="@string/add_plant_species" />

            <LinearLayout
                android:id="@+id/cardSpecies"
                style="@style/Leafy.Card"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgSpecies"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@color/leafy_primary_container"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Leafy.Shape.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSpeciesName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_plant_species_required"
                        android:textColor="@color/leafy_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeciesSci"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/leafy_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeSpecies"
                    style="@style/Leafy.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_plant_species_change" />
            </LinearLayout>

            <!-- Tên gọi -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/add_plant_name"
                app:boxStrokeColor="@color/leafy_primary"
                app:counterEnabled="true"
                app:counterMaxLength="50"
                app:helperText="@string/add_plant_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ngày trồng -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPlantedDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/add_plant_planted_date"
                app:boxStrokeColor="@color/leafy_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlantedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ngưỡng môi trường -->
            <LinearLayout
                android:id="@+id/cardThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_leafy_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_plant_threshold_title"
                    android:textColor="@color/leafy_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/add_plant_threshold_note"
                    android:textColor="@color/leafy_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/containerThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Lịch chăm sóc đề xuất -->
            <TextView
                style="@style/Leafy.SectionTitle"
                android:layout_marginBottom="2dp"
                android:text="@string/add_plant_schedule_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/add_plant_schedule_note"
                android:textColor="@color/leafy_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/containerSchedules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/leafy_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Leafy.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/add_plant_save" />
    </LinearLayout>
</LinearLayout>
