<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leafy_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ẢNH BÌA + TÊN -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/leafy_primary_container"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="40dp">

                    <TextView
                        android:id="@+id/tvHealth"
                        style="@style/Leafy.Pill"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpecies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvScientific"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </FrameLayout>

            <!-- THẺ TÓM TẮT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_leafy_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/Leafy.Stat">
                        <TextView android:id="@+id/tvStatToday" style="@style/Leafy.Stat.Value" />
                        <TextView style="@style/Leafy.Stat.Label" android:text="@string/pd_stat_today" />
                    </LinearLayout>

                    <LinearLayout style="@style/Leafy.Stat">
                        <TextView android:id="@+id/tvStatCare" style="@style/Leafy.Stat.Value" />
                        <TextView style="@style/Leafy.Stat.Label" android:text="@string/pd_stat_care" />
                    </LinearLayout>

                    <LinearLayout style="@style/Leafy.Stat">
                        <TextView android:id="@+id/tvStatDiag" style="@style/Leafy.Stat.Value" />
                        <TextView style="@style/Leafy.Stat.Label" android:text="@string/pd_stat_diag" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/leafy_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHealthCheck"
                    style="@style/Leafy.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pd_health_check"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/leafy_background"
                app:tabIndicatorColor="@color/leafy_primary"
                app:tabIndicatorFullWidth="false"
                app:tabSelectedTextColor="@color/leafy_primary"
                app:tabTextColor="@color/leafy_text_secondary" />

            <LinearLayout
                android:id="@+id/containerTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- nút nổi trên ảnh bìa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/common_close"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/leafy_text" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/pd_more"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/leafy_text" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
