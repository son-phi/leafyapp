<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="leafyapp.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1505"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="diseases" custom_title="0" dock_id="1" table="4,8:maindiseases"/><dock_state state="000000ff00000000fd0000000100000002000005f4000002aefc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f40000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="diseases" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="117"/><column index="3" value="163"/><column index="4" value="195"/><column index="5" value="300"/><column index="6" value="148"/><column index="7" value="300"/><column index="8" value="300"/><column index="9" value="300"/><column index="10" value="300"/><column index="11" value="300"/><column index="12" value="300"/><column index="13" value="300"/><column index="14" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO diseases (id, disease,reason1, solu1, reason2, solu2, reason3, solu3, reason4, solu4, cay1,cay2, cay3, cay4) VALUES (0,'Nâu đầu lá', 'Độ ẩm không khí thấp','Tăng độ ẩm xung quanh cây.', 'Tích tụ muối khoáng','Xả nước qua chậu (Flushing) định kỳ. Sử dụng nước cất, nước mưa hoặc nước đã để lắng để giảm Clo/Flo.', 'Tưới nước không đều','Điều chỉnh thói quen tưới. Tưới sâu và kỹ, sau đó để đất khô đúng mức yêu cầu của từng cây.', 'Cháy nắng','Di chuyển cây khỏi ánh nắng trực tiếp gay gắt (đặc biệt là nắng buổi trưa).', 'Dương xỉ Boston, Cẩm nhung sọc, Lan ý, Trầu bà, Cọ cảnh mini, Thiên điểu, Hoa tử la lan.', 'Nha đam, Lan ý, Cây bắt mồi, Ngọc bích, Cau cảnh.', 'Hoa tử la lan, Hồng môn, Trạng nguyên.', 'Hồng môn, Thu hải đường, Cây đốm hồng, Ngọc bích.');
INSERT INTO diseases (id, disease,reason1, solu1, reason2, solu2, reason3, solu3, reason4, solu4,cay1,cay2,cay3,cay4) VALUES (1,'Đốm nấm', 'Môi trường ẩm ướt','Cải thiện lưu thông không khí (mở cửa sổ, dùng quạt nhẹ). Tránh làm ướt lá khi tưới (chỉ tưới vào gốc).', 'Lây bệnh từ các cây khác','Cắt bỏ ngay lập tức các lá, hoa hoặc cành bị đốm nấm, thối nhũn. Tiêu hủy phần bệnh, không để trong chậu hoặc compost.', 'Sử dụng các chất hóa học không đúng cách','Sử dụng thuốc diệt nấm phổ rộng (ví dụ: Dầu Neem, thuốc gốc Đồng, Mancozeb) theo hướng dẫn trên bao bì.', 'Cây bị thối rễ/ củ','Nếu nấm phát triển do úng nước (thối rễ), phải ngừng tưới ngay lập tức. Cắt bỏ rễ/củ bị nhũn và trồng lại bằng đất mới, thoáng khí.', 'Hoa cúc (Phấn trắng), Thu hải đường (Phấn trắng), Lan ý, Hồng môn, Trạng nguyên.', 'Tất cả các loại cây, đặc biệt Hoa tulip, Lưỡi hổ, Lan ý.', 'Phổ biến: Hoa cúc, Thủy tiên, Thường xuân, Cau cảnh, Tuế cảnh.', 'Cần thiết cho: Nha đam, Lưỡi hổ, Kim phát tài, Xương rồng giáng sinh, Trầu bà.');
INSERT INTO diseases (id, disease,reason1, solu1, reason2, solu2, reason3, solu3, reason4, solu4,cay1,cay2,cay3,cay4) VALUES (3,'Vàng lá', 'Tưới quá nhiều nước','Giảm tần suất tưới. Để đất khô đúng mức giữa các lần tưới. Đảm bảo chậu có lỗ thoát nước tốt.', 'Thiếu dinh dưỡng','Bổ sung phân bón cân đối NPK. Nếu lá vàng giữa gân (gân vẫn xanh - Chlorosis), cần bổ sung Sắt hoặc Magie.', 'Thiếu ánh sáng','Di chuyển cây đến vị trí sáng hơn (ánh sáng gián tiếp mạnh).', 'Lá già tự nhiên','Cắt bỏ lá già (thường là lá dưới cùng, vàng và khô) để cây tập trung năng lượng.', 'Nha đam, Lưỡi hổ, Kim phát tài, Ngọc bích, Cây đồng tiền TQ, Hoa tử la lan.', 'Cau cảnh (Magie), Thường xuân (Sắt), Rau sam cảnh (Nitơ), Lan ý (Sắt).', 'Nha đam, Cây bắt mồi, Cây đốm hồng, Cây đuôi rắn.', 'Thiên điểu, Cây đồng tiền TQ, Tuế cảnh, Cọ cảnh mini, Hoa tulip/Lan dạ hương (sau khi ra hoa).');
</sql><current_tab id="0"/></tab_sql></sqlb_project>
